# ===== 服务基础 =====
PORT=8000
# 查岗上报鉴权（iPhone快捷指令用）
AUTH_TOKEN=换成你的密码

# ===== Kelivo Gateway =====
TARGET_API_URL=https://api.deepseek.com/v1/chat/completions
TARGET_API_KEY=你的APIKey
MODEL_NAME=deepseek-chat
GATEWAY_API_KEY=你的gatewaykey
ALLOW_PUBLIC_API=false

# ===== Bark推送 =====
BARK_KEY=你的BarkKey
CUSTOM_ICON_URL=

# ===== 心潮DM动态状态 =====
TIME_ZONE=Asia/Shanghai

# ===== 欲望账本（远端GitHub） =====
GH_TOKEN=占位符
GH_REPO=占位符_owner/repo
GH_DESIRES_FILE=desires.json

# ===== 远程遥控（163邮箱，可选） =====
MAIL_USER=
MAIL_AUTH_CODE=
MAIL_SMTP_HOST=smtp.163.com
MAIL_SMTP_PORT=465
MAIL_TO=

# ===== 自动唤醒 =====
DAY_WAKE_AFTER_MINUTES=60
NIGHT_WAKE_AFTER_MINUTES=120
DAY_CHECK_INTERVAL_MINUTES=10
NIGHT_CHECK_INTERVAL_MINUTES=120
WAKE_DAY_START_HOUR=10
WAKE_DAY_END_HOUR=24
WEATHER_ENABLED=false
WEATHER_LOCATION_NAME=石家庄
WEATHER_LAT=
WEATHER_LON=
DIARY_ENABLED=true
DIARY_DIR=diary
